{
  "name": "@arkhe/ui",
  "version": "0.1.0",
  "private": true,
  "description": "Arkhe UI — Fase 1: design system (tokens, primitivos, verificação de contraste)",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/arkhe-ui.css"
  },
  "scripts": {
    "dev": "storybook dev -p 6006",
    "build": "vite build",
    "preview": "vite preview",
    "dev:app": "npm run build && vite --config vite.config.app.ts",
    "build:app": "npm run build && vite build --config vite.config.app.ts",
    "preview:app": "vite preview --config vite.config.app.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "chromatic": "chromatic --project-token=$CHROMATIC_TOKEN"
  },
  "dependencies": {
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "d3": "7.9.0",
    "lucide-react": "1.46.0",
    "radix-ui": "1.6.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "3.7.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@storybook/addon-a11y": "10.6.0",
    "@storybook/react": "10.6.0",
    "@storybook/react-vite": "10.6.0",
    "@storybook/test-runner": "0.24.5",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "22.20.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/coverage-v8": "5.0.0",
    "axe-core": "4.13.0",
    "chromatic": "18.8.1",
    "jsdom": "30.0.1",
    "storybook": "10.6.0",
    "storybook-addon-design-system-docs": "1.0.2",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "vitest": "5.0.0"
  },
  "engines": {
    "node": ">=22.22.2"
  }
}
