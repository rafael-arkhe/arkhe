{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Arkhe",
  "version": "0.2.0",
  "identifier": "org.arkhe-os.arkhe",
  "build": {
    "beforeDevCommand": "npm run dev:app",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build:app",
    "frontendDist": "../dist-app"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Arkhe — verificação de atestações",
        "width": 1100,
        "height": 820,
        "minWidth": 720,
        "minHeight": 560,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "DeveloperTool",
    "shortDescription": "Verificação de atestações do Arkhe OS",
    "longDescription": "Verificação client-side (SHA-256, Ed25519 contra um trust root, inclusão Merkle RFC 6962 e quórum de testemunhas) e inspecção de modelos GGUF pelo núcleo nativo arkhe-verify."
  },
  "plugins": {
    "hashtree-updater": {
      "reference": "htree://npub1ql0eyuuwsvju0g65cge03c762f4qm9yprl0aymru6lszrzdd0tqsvmcnnk/releases%2Farkhe-os/latest",
      "manifestPath": "release.json"
    }
  }
}
