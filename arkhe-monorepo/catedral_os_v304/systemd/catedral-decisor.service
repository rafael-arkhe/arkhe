[Unit]
Description=Catedral OS Decisor Daemon
After=catedral-orquestrador.service
Wants=catedral-orquestrador.service

[Service]
Type=simple
User=arkhe
Group=arkhe
ExecStart=/arkhe/venv/bin/python3 /opt/catedral-os/python/daemons/decisor.py
Restart=on-failure
RestartSec=3
Environment=PYTHONPATH=/opt/catedral-os/python
WorkingDirectory=/opt/catedral-os/python
StandardOutput=journal
StandardError=journal
SyslogIdentifier=catedral-decisor

[Install]
WantedBy=multi-user.target