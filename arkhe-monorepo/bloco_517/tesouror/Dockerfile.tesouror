# Dockerfile.tesouror — v77 VETADO — BLOCO 517 (F1)
#
# Imagem para Tesouror: R 4.3 (tesouror) + Python 3.11 (sensor/adapter).
# Nao executado neste ambiente (sem Docker); pronto para `docker build -f Dockerfile.tesouror .`
FROM rocker/r-ver:4.3.0

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
    libcurl4-openssl-dev \
    libssl-dev \
    libxml2-dev \
    python3 \
    python3-pip \
    python3-venv \
    && rm -rf /var/lib/apt/lists/*

RUN R -e "install.packages(c('remotes', 'jsonlite', 'httr'), repos='https://cloud.r-project.org')"
RUN R -e "remotes::install_github('strategicprojects/tesouror', quiet=TRUE)"

COPY requirements.txt /app/requirements.txt
RUN python3 -m venv /opt/arkhe/venv && \
    /opt/arkhe/venv/bin/pip install --upgrade pip --quiet && \
    /opt/arkhe/venv/bin/pip install --no-cache-dir -r /app/requirements.txt --quiet

COPY tesouror_adapter.py /app/tesouror_adapter.py
COPY tesouror_sensor.py /app/tesouror_sensor.py

RUN useradd --create-home --shell /bin/bash arkhe && chown -R arkhe:arkhe /app
USER arkhe
WORKDIR /app

CMD ["/opt/arkhe/venv/bin/python3", "-c", \
     "from tesouror_sensor import TesourorSensor; print('Tesouror Sensor ready')"]